---
import { navLinks, site } from '../data/site';
import Logo from './Logo.astro';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-forest/5 bg-cream/95 backdrop-blur-md transition-shadow duration-300 [&.scrolled]:shadow-md"
>
  <div class="container-narrow flex items-center justify-between gap-4 px-5 py-4 md:px-8 lg:px-12">
    <a href="/" class="group shrink-0 transition-opacity hover:opacity-90" aria-label="Eco Heat ASHP Ltd — Home">
      <Logo variant="nav" />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main navigation">
      {
        navLinks.map((link) =>
          link.children ? (
            <div class="relative">
              <button
                id="services-dropdown-trigger"
                class="flex items-center gap-1 text-sm font-semibold text-ink transition-colors hover:text-green"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {link.label}
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                    clip-rule="evenodd"></path>
                </svg>
              </button>
              <div
                id="services-dropdown"
                class="invisible absolute left-0 top-full z-50 mt-2 min-w-[260px] translate-y-2 rounded-2xl border border-forest/10 bg-white p-2 opacity-0 shadow-xl transition-all [&.open]:visible [&.open]:translate-y-0 [&.open]:opacity-100"
              >
                {
                  link.children.map((child) => (
                    <a
                      href={child.href}
                      class="block rounded-xl px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-cream hover:text-green"
                    >
                      {child.label}
                    </a>
                  ))
                }
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class="text-sm font-semibold text-ink transition-colors hover:text-green"
            >
              {link.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact" class="btn-primary hidden text-sm sm:inline-flex">Book a free survey</a>
      <button
        id="nav-toggle"
        class="relative z-50 flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-full border border-forest/10 lg:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block h-0.5 w-5 bg-ink transition-all [.open>&]:translate-y-2 [.open>&]:rotate-45"
        ></span>
        <span class="block h-0.5 w-5 bg-ink transition-all [.open>&]:opacity-0"></span>
        <span class="block h-0.5 w-5 bg-ink transition-all [.open>&]:-translate-y-2 [.open>&]:-rotate-45"
        ></span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="fixed inset-0 top-[73px] z-40 hidden bg-cream px-5 pb-8 pt-6 [.open&]:block lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      {
        navLinks.map((link) =>
          link.children ? (
            <div>
              <button
                id="mobile-services-toggle"
                class="flex w-full items-center justify-between rounded-xl px-4 py-3 text-left text-lg font-semibold text-ink"
                aria-expanded="false"
              >
                {link.label}
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                    clip-rule="evenodd"></path>
                </svg>
              </button>
              <div id="mobile-services-list" class="hidden pl-4 [.open&]:block">
                {
                  link.children.map((child) => (
                    <a
                      href={child.href}
                      class="block rounded-xl px-4 py-2.5 text-base text-muted hover:text-green"
                    >
                      {child.label}
                    </a>
                  ))
                }
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class="rounded-xl px-4 py-3 text-lg font-semibold text-ink hover:text-green"
            >
              {link.label}
            </a>
          ),
        )
      }
      <a href="/contact" class="btn-primary mt-4 w-full text-center">Book a free survey</a>
      <a href={site.phoneHref} class="mt-3 text-center text-sm font-semibold text-green">
        {site.phone}
      </a>
    </nav>
  </div>
</header>

<style>
  #mobile-menu.open {
    display: block;
  }
</style>

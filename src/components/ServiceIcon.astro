---
import type { ServiceIcon } from '../data/site';

interface Props {
  name: ServiceIcon;
  class?: string;
}

const { name, class: className = 'h-10 w-10 text-green' } = Astro.props;

const icons: Record<ServiceIcon, string> = {
  'heat-pump': `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="11" width="36" height="26" rx="3"/><line x1="6" y1="17" x2="42" y2="17"/><circle cx="24" cy="27" r="7.5"/><path d="M24 27 L24 20.5 M24 27 L29.6 30.2 M24 27 L18.4 30.2"/></svg>`,
  'air-con': `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="14" width="32" height="20" rx="2"/><path d="M16 24h16M20 20v8M28 20v8"/><path d="M24 8v6M18 10l3 5M30 10l-3 5"/></svg>`,
  servicing: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 32l-4 4a4 4 0 01-5.7-5.7l4-4"/><path d="M32 16l4-4a4 4 0 015.7 5.7l-4 4"/><path d="M14 34l10-10"/><path d="M20 14l14 14"/></svg>`,
  solar: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="6"/><path d="M24 4v6M24 38v6M4 24h6M38 24h6M10 10l4.2 4.2M33.8 33.8l4.2 4.2M10 38l4.2-4.2M33.8 14.2l4.2-4.2"/></svg>`,
  underfloor: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="20" width="36" height="18" rx="2"/><path d="M12 28h24M12 32h24M12 36h24"/><path d="M24 8v8"/></svg>`,
};
---

<span class:list={[className, 'inline-block']} set:html={icons[name]} />

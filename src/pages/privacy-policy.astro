---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Layout
  title="Privacy Policy | Eco Heat ASHP Ltd"
  description="Privacy policy for Eco Heat ASHP Ltd website."
>
  <Header />
  <main class="pt-28 md:pt-32">
    <section class="section-padding">
      <div class="container-narrow mx-auto max-w-3xl">
        <h1 class="mb-8 font-heading text-4xl font-bold text-ink">Privacy Policy</h1>
        <div class="prose-content">
          <p>
            Eco Heat ASHP Ltd ("we", "us", "our") respects your privacy. This policy explains how we
            collect and use personal information when you visit our website or contact us.
          </p>
          <h3>Information we collect</h3>
          <p>
            When you submit our contact form, we collect your name, email address and message content
            so we can respond to your enquiry.
          </p>
          <h3>How we use your information</h3>
          <p>
            We use your information solely to respond to enquiries and provide our services. We do
            not sell or share your personal data with third parties for marketing purposes.
          </p>
          <h3>Contact form processing</h3>
          <p>
            Form submissions are processed via Web3Forms to deliver your message to us securely.
          </p>
          <h3>Cookies</h3>
          <p>
            This website may use essential cookies required for basic functionality. We do not use
            tracking or advertising cookies.
          </p>
          <h3>Your rights</h3>
          <p>
            You may request access to, correction of, or deletion of your personal data by contacting
            us at <a href={site.emailHref} class="text-green hover:text-amber">{site.email}</a>.
          </p>
          <h3>Contact</h3>
          <p>
            For privacy-related questions, contact {site.name} at {site.address.full} or email{' '}
            <a href={site.emailHref} class="text-green hover:text-amber">{site.email}</a>.
          </p>
          <p class="text-sm text-muted">Last updated: August 2026</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

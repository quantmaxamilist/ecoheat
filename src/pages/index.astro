---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import AccreditationsBar from '../components/AccreditationsBar.astro';
import {
  services,
  trustItems,
  whyRenewable,
  reasonsToSwitch,
  reviews,
  galleryPreview,
  workPhotos,
  workPhotoCount,
  site,
} from '../data/site';
---

<Layout ogImage="/hero.jpg">
  <Header />
  <main>
    <!-- Hero -->
    <section class="bg-cream pt-28 md:pt-32">
      <div class="section-padding !pt-8">
        <div class="container-narrow grid items-center gap-10 lg:grid-cols-2">
          <div>
            <p class="eyebrow mb-4" data-reveal>MCS CERTIFIED · NORTH WEST</p>
            <h1
              class="mb-5 font-heading text-4xl font-bold leading-tight text-ink md:text-5xl lg:text-6xl"
              data-reveal
            >
              Warmer homes, lower bills.
            </h1>
            <p class="mb-6 text-lg leading-relaxed text-muted" data-reveal>
              Renewable heating specialists — air source heat pumps, solar, underfloor heating and
              servicing across Lancashire. Designed, installed and looked after by Ecoheat.
            </p>
            <div class="mb-8 flex flex-col gap-3 sm:flex-row" data-reveal>
              <a href="/contact" class="btn-primary">Book a free survey</a>
              <a href="#services" class="btn-outline">Our services</a>
            </div>
            <div class="flex flex-wrap gap-2" data-reveal>
              <span class="rounded-full bg-green/10 px-3 py-1 text-xs font-bold text-green"
                >MCS Certified</span
              >
              <span class="rounded-full bg-green/10 px-3 py-1 text-xs font-bold text-green"
                >25+ Years</span
              >
              <span class="rounded-full bg-green/10 px-3 py-1 text-xs font-bold text-green"
                >5★ Reviews</span
              >
            </div>
          </div>
          <div class="overflow-hidden rounded-3xl shadow-xl" data-reveal>
            <img
              src="/hero.jpg"
              alt="Modern air source heat pump outside a contemporary home"
              class="aspect-[4/3] w-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <AccreditationsBar />

    <!-- Trust bar -->
    <section class="border-y border-forest/10 bg-white py-6">
      <div class="container-narrow px-5 md:px-8 lg:px-12">
        <ul
          class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-center text-sm font-semibold text-ink md:gap-x-10 md:text-base"
        >
          {
            trustItems.map((item) => (
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-amber" aria-hidden="true"></span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="section-padding">
      <div class="container-narrow">
        <div class="mb-12 max-w-2xl">
          <p class="eyebrow mb-3" data-reveal>What we do</p>
          <h2 class="font-heading text-3xl font-bold text-ink md:text-4xl" data-reveal>
            Renewable heating services
          </h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            services.map((service) => (
              <a
                href={service.href}
                class="group rounded-3xl border border-forest/10 bg-white p-6 transition-all hover:-translate-y-1 hover:border-green/20 hover:shadow-lg"
                data-reveal
              >
                <ServiceIcon name={service.icon} class="mb-4 h-10 w-10 text-green" />
                <h3 class="mb-2 font-heading text-xl font-bold text-ink">{service.title}</h3>
                <p class="mb-4 text-sm text-muted">{service.description}</p>
                <span class="text-sm font-bold text-green transition-colors group-hover:text-amber">
                  Learn more →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Why renewable -->
    <section class="section-padding bg-white">
      <div class="container-narrow grid items-center gap-10 lg:grid-cols-2">
        <div data-reveal>
          <p class="eyebrow mb-3">Why renewable?</p>
          <h2 class="mb-6 font-heading text-3xl font-bold text-ink md:text-4xl">
            Why choose renewable technologies?
          </h2>
          <ul class="space-y-4">
            {
              whyRenewable.map((point) => (
                <li class="flex gap-3">
                  <span
                    class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-green/10 text-sm font-bold text-green"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                  <span class="text-muted">{point}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="overflow-hidden rounded-3xl shadow-lg" data-reveal>
          <img
            src="/images/why-renewable.jpg"
            alt="Modern energy-efficient family home with smart heating controls"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- Reasons to switch -->
    <section class="section-padding">
      <div class="container-narrow">
        <div class="mb-12 text-center">
          <p class="eyebrow mb-3" data-reveal>Benefits</p>
          <h2 class="font-heading text-3xl font-bold text-ink md:text-4xl" data-reveal>
            Reasons to switch
          </h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            reasonsToSwitch.map((reason) => (
              <div
                class="rounded-3xl border border-forest/10 bg-white p-6"
                data-reveal
              >
                <div
                  class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-amber/15 text-amber"
                  aria-hidden="true"
                >
                  ★
                </div>
                <h3 class="mb-2 font-heading text-lg font-bold text-ink">{reason.title}</h3>
                <p class="text-sm text-muted">{reason.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Reviews -->
    <section class="section-padding bg-forest text-white">
      <div class="container-narrow">
        <div class="mb-12 text-center">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-amber" data-reveal>
            Reviews
          </p>
          <h2 class="font-heading text-3xl font-bold md:text-4xl" data-reveal>
            What our customers say
          </h2>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {
            reviews.map((review) => (
              <blockquote
                class="rounded-3xl bg-white/5 p-6 backdrop-blur-sm"
                data-reveal
              >
                <div class="mb-3 text-amber" aria-label="5 out of 5 stars">★★★★★</div>
                <p class="mb-4 text-sm leading-relaxed text-white/85">"{review.quote}"</p>
                <footer class="text-sm font-bold text-amber">{review.name}</footer>
              </blockquote>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Our Work preview -->
    <section class="section-padding">
      <div class="container-narrow">
        <div class="mb-10 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="eyebrow mb-3" data-reveal>Portfolio</p>
            <h2 class="font-heading text-3xl font-bold text-ink md:text-4xl" data-reveal>
              Our recent work
            </h2>
          </div>
          <a href="/our-work" class="text-sm font-bold text-green hover:text-amber" data-reveal>
            View all work →
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            galleryPreview.map((photo) => (
              <figure class="group overflow-hidden rounded-2xl" data-reveal>
                <div class="overflow-hidden">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
                <figcaption class="mt-2 text-sm font-medium text-muted">{photo.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Coverage -->
    <section class="section-padding bg-white">
      <div class="container-narrow grid items-center gap-10 lg:grid-cols-2">
        <div class="overflow-hidden rounded-3xl shadow-lg" data-reveal>
          <img
            src="/images/coverage.jpg"
            alt="Residential property in Lancashire served by Eco Heat ASHP"
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
        </div>
        <div data-reveal>
          <p class="eyebrow mb-3">Coverage</p>
          <h2 class="mb-4 font-heading text-3xl font-bold text-ink md:text-4xl">
            Covering Preston and the North West
          </h2>
          <p class="mb-4 text-muted">
            Based in Fulwood, Preston, we cover a {site.coverage.toLowerCase()} — residential and
            commercial installations and servicing.
          </p>
          <a href="/contact" class="btn-primary">Get in touch</a>
        </div>
      </div>
    </section>

    <Faq />
    <CtaBand />
  </main>
  <Footer />
</Layout>

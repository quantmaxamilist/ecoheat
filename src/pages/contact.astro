---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, heroImages } from '../data/site';
---

<Layout
  title="Contact | Eco Heat ASHP Ltd"
  description="Contact Eco Heat ASHP Ltd for a free survey. Call 07949 570392 or email andy@ecoheatashp.co.uk. Based in Preston, serving the North West."
>
  <Header />
  <main class="pt-28 md:pt-32">
    <section class="section-padding">
      <div class="container-narrow">
        <p class="eyebrow mb-3" data-reveal>Contact</p>
        <h1 class="mb-4 font-heading text-4xl font-bold text-ink md:text-5xl" data-reveal>
          Get in touch
        </h1>
        <p class="mb-12 max-w-2xl text-lg text-muted" data-reveal>
          Book your free survey or ask a question — Andy and the team are happy to help with
          renewable heating advice across Lancashire and the North West.
        </p>

        <div class="grid gap-10 lg:grid-cols-2">
          <form
            id="contact-form"
            class="rounded-3xl border border-forest/10 bg-white p-6 md:p-8"
            data-reveal
          >
            <div id="form-status" class="mb-4 hidden rounded-xl p-4 text-sm" role="status"></div>

            <div class="mb-5">
              <label for="name" class="mb-2 block text-sm font-semibold text-ink">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full rounded-xl border border-forest/15 bg-cream px-4 py-3 text-ink outline-none transition-colors focus:border-green"
              />
            </div>
            <div class="mb-5">
              <label for="email" class="mb-2 block text-sm font-semibold text-ink">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-xl border border-forest/15 bg-cream px-4 py-3 text-ink outline-none transition-colors focus:border-green"
              />
            </div>
            <div class="mb-5">
              <label for="message" class="mb-2 block text-sm font-semibold text-ink">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full resize-y rounded-xl border border-forest/15 bg-cream px-4 py-3 text-ink outline-none transition-colors focus:border-green"
              ></textarea>
            </div>
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
            <button type="submit" class="btn-primary w-full sm:w-auto">Send message</button>
          </form>

          <div class="space-y-6" data-reveal>
            <div class="rounded-3xl bg-forest p-8 text-white">
              <h2 class="mb-6 font-heading text-xl font-bold text-amber">Contact details</h2>
              <dl class="space-y-4 text-sm">
                <div>
                  <dt class="mb-1 font-bold text-white/60">Phone</dt>
                  <dd>
                    <a href={site.phoneHref} class="text-lg font-bold text-white hover:text-amber">
                      {site.phone}
                    </a>
                  </dd>
                </div>
                <div>
                  <dt class="mb-1 font-bold text-white/60">Email</dt>
                  <dd>
                    <a href={site.emailHref} class="hover:text-amber">{site.email}</a>
                  </dd>
                </div>
                <div>
                  <dt class="mb-1 font-bold text-white/60">Address</dt>
                  <dd class="text-white/85">
                    {site.address.line1}<br />{site.address.line2}
                  </dd>
                </div>
                <div>
                  <dt class="mb-1 font-bold text-white/60">Coverage</dt>
                  <dd class="text-white/85">{site.coverage}</dd>
                </div>
              </dl>
            </div>
            <div class="overflow-hidden rounded-3xl shadow-lg">
              <img
                src={heroImages.ashp}
                alt="Outdoor air source heat pump system installed by Ecoheat in Lancashire"
                class="aspect-[16/10] w-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status) return;

      if (!accessKey) {
        status.className =
          'mb-4 rounded-xl bg-amber/15 p-4 text-sm text-ink border border-amber/30';
        status.textContent =
          'The contact form is not yet configured. Please email andy@ecoheatashp.co.uk directly.';
        status.classList.remove('hidden');
        return;
      }

      const formData = new FormData(form);
      formData.append('access_key', accessKey);
      formData.append('subject', 'New enquiry from ecoheatashp');

      status.className = 'mb-4 rounded-xl bg-green/10 p-4 text-sm text-ink';
      status.textContent = 'Sending…';
      status.classList.remove('hidden');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });
        const data = (await response.json()) as { success?: boolean; message?: string };

        if (data.success) {
          status.className = 'mb-4 rounded-xl bg-green/10 p-4 text-sm text-green border border-green/20';
          status.textContent = 'Thank you — your message has been sent. Andy will be in touch soon.';
          form.reset();
        } else {
          throw new Error(data.message ?? 'Submission failed');
        }
      } catch {
        status.className = 'mb-4 rounded-xl bg-red-50 p-4 text-sm text-red-800 border border-red-200';
        status.textContent =
          'Something went wrong. Please try again or email andy@ecoheatashp.co.uk directly.';
      }
    });
  </script>
</Layout>

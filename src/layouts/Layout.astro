---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Eco Heat ASHP Ltd | Renewable Heating Specialists in Preston',
  description = 'MCS certified renewable heating specialists in Preston, Lancashire. Air source heat pumps, solar, underfloor heating, air conditioning and servicing across the North West.',
  ogImage = '/work/W1.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const schemaLd = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  name: 'Eco Heat ASHP Ltd',
  description,
  url: 'https://ecoheatashp.co.uk',
  telephone: '+447949570392',
  email: 'andy@ecoheatashp.co.uk',
  image: 'https://ecoheatashp.co.uk/logo.png',
  logo: 'https://ecoheatashp.co.uk/logo.png',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '14 Briery Close, Fulwood',
    addressLocality: 'Preston',
    addressRegion: 'Lancashire',
    postalCode: 'PR2 6XU',
    addressCountry: 'GB',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 53.789,
    longitude: -2.688,
  },
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: 53.789,
      longitude: -2.688,
    },
    geoRadius: '48280',
  },
  priceRange: '££',
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '18:00',
  },
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schemaLd)} />
  </head>
  <body>
    <slot />
    <script src="../scripts/animations.ts"></script>
  </body>
</html>
